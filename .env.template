# Safe Computer Class - Server Configuration Template
# Copy this file to .env and adjust the values for your environment
# Used by docker-compose.yml

# Samba/SMB Configuration
# External IP/hostname of the Samba server
SAFE_CLASS_SMB_SERVER=192.168.1.10

# Network drive letter for Windows clients
SAFE_CLASS_DRIVE=Z:

# Optional: Samba password (not recommended to store here, use domain auth)
# SAFE_CLASS_SMB_PASSWORD=your_secure_password

# Optional: Return password to authenticated clients (use with caution!)
# SAFE_CLASS_AUTH_RETURN_PASSWORD=0

# HTTP Service Configuration
# Host to bind to (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
SCC_HOST=0.0.0.0

# Port to listen on
SCC_PORT=80

# Logging
# Set to DEBUG for verbose logging
LOG_LEVEL=INFO
